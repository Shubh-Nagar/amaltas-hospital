# Amaltas Super Speciality Hospital — environment example
# The site builds and runs with NO env vars set. These are placeholders for
# future integrations. Copy to `.env.local` and fill in when wiring backends.

# Public base URL used for canonical/OG tags at build time (optional).
# Falls back to the value in src/data/site.ts (siteUrl) when unset.
VITE_SITE_URL=https://amaltashospital.in

# Secure endpoint that will receive appointment-request submissions.
# Until this is set, the appointment form validates and shows a success state
# WITHOUT transmitting data (see src/pages/AppointmentPage.tsx TODO).
VITE_APPOINTMENT_ENDPOINT=

# Optional analytics/measurement id (not wired by default).
VITE_ANALYTICS_ID=
